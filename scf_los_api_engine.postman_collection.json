          "response": []
        },
        {
          "name": "Trigger Ad-hoc Custom Sequence (via ARQ Queue)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"sequence\": [\n        \"create_post_service\",\n        [\n            \"get_post_service\"\n        ]\n    ],\n    \"inputs\": {\n        \"create_post_service\": {\n            \"title\": \"Adhoc Post\",\n            \"body\": \"Adhoc Body\",\n            \"userId\": 1\n        },\n        \"get_post_service\": {\n            \"post_id\": 1\n        }\n    },\n    \"mappings\": [\n        {\n            \"from_service\": \"create_post_service\",\n            \"from_field\": \"data.id\",\n            \"to_service\": \"get_post_service\",\n            \"to_field\": \"post_id\"\n        }\n    ],\n    \"idempotency_key\": \"idemp-adhoc-posts-001\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/chain/trigger",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "chain",
                "trigger"
              ]
            }
          },
          "response": []
        },
