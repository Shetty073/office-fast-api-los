    {
      "name": "04. Orchestration & Task Execution",
      "item": [
        {
          "name": "Trigger Sequence by Name (via ARQ Queue)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"payload\": {\n        \"post_title\": \"Real REST Orchestrated Post\",\n        \"post_body\": \"Post created via JSONPlaceholder integration\",\n        \"update_title\": \"Updated REST Post Title\",\n        \"update_body\": \"Post body updated via PUT step\"\n    }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/chain/trigger/post_lifecycle_pipeline",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
