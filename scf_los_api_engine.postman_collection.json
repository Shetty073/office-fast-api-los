    {
      "name": "03. Sequence Recipes",
      "item": [
        {
          "name": "Register / Update Sequence Recipe in DB",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"user_onboarding_flow\",\n    \"description\": \"Onboarding pipeline: fetches todo item and maps its title to post body\",\n    \"sequence\": [\n        \"todo_service\",\n        \"post_service\"\n    ],\n    \"default_inputs\": {\n        \"todo_service\": {\n            \"_mock\": true\n        },\n        \"post_service\": {\n            \"title\": \"Automated Onboarding Post\",\n            \"_mock\": true\n        }\n    },\n    \"mappings\": [\n        {\n            \"from_service\": \"trigger_payload\",\n            \"from_field\": \"customer_id\",\n            \"to_service\": \"todo_service\",\n            \"to_field\": \"todo_id\"\n        },\n        {\n            \"from_service\": \"todo_service\",\n            \"from_field\": \"data.title\",\n            \"to_service\": \"post_service\",\n            \"to_field\": \"body\",\n            \"transform\": \"upper\"\n        }\n    ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/sequences",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "sequences"
              ]
            }
          },
          "response": []
        },
        {
