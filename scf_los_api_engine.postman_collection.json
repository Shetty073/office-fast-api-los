    {
      "name": "Trigger Chain - Conditional Routing & Webhooks",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"sequence\": [\n        \"todo_service\",\n        \"post_service\"\n    ],\n    \"inputs\": {\n        \"todo_service\": {\n            \"todo_id\": 2\n        },\n        \"post_service\": {\n            \"body\": \"Conditional post execution body\"\n        }\n    },\n    \"mappings\": [\n        {\n            \"from_service\": \"todo_service\",\n            \"from_field\": \"id\",\n            \"to_service\": \"post_service\",\n            \"to_field\": \"userId\",\n            \"transform\": \"to_int\"\n        }\n    ],\n    \"conditions\": {\n        \"post_service\": \"responses.todo_service.data.completed == True\"\n    },\n    \"context\": {\n        \"client_type\": \"premium\"\n    },\n    \"callback_url\": \"https://your.webhook.domain/callbacks\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
