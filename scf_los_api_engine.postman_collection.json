        {
          "name": "Trigger Ad-hoc Custom Sequence (via ARQ Queue)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"sequence\": [\n        \"todo_service\",\n        [\n            \"post_service\"\n        ]\n    ],\n    \"inputs\": {\n        \"todo_service\": {\n            \"todo_id\": 2,\n            \"_mock\": true\n        },\n        \"post_service\": {\n            \"title\": \"Parallel Step Post\",\n            \"body\": \"Dynamic Body\",\n            \"_mock\": true\n        }\n    },\n    \"mappings\": [\n        {\n            \"from_service\": \"todo_service\",\n            \"from_field\": \"data.title\",\n            \"to_service\": \"post_service\",\n            \"to_field\": \"body\"\n        }\n    ],\n    \"idempotency_key\": \"idemp-adhoc-001\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/chain/trigger",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "chain",
                "trigger"
              ]
            }
          },
          "response": []
        },
