{
  "name": "05_resilient_retries_and_success_conditions",
  "description": "Demonstrates field equality, inequality, data type assertions, and HTTP status code validation in task success rules",
  "sequence": [
    "todo_service",
    "post_service"
  ],
  "default_inputs": {
    "todo_service": {
      "todo_id": 10,
      "_mock": true
    },
    "post_service": {
      "title": "Post asserting status codes",
      "body": "Payload",
      "_mock": true
    }
  },
  "mappings": [
    {
      "from_service": "todo_service",
      "from_field": "data.title",
      "to_service": "post_service",
      "to_field": "body",
      "transform": "upper"
    }
  ],
  "success_conditions": {
    "todo_service": {
      "expected_status_code": 200,
      "equals": {
        "success": true,
        "data.completed": true
      },
      "not_equals": {
        "data.is_blacklisted": true
      },
      "types": {
        "data.id": "int",
        "data.title": "str"
      }
    }
  }
}
